#!/usr/bin/env bash
set -euo pipefail
namespace=ozzy-jepsen-probe
cleanup() {
    # Deleting a namespace name need not destroy a namespace still referenced
    # by an exiting process or socket. Remove both veth ends explicitly.
    if ip link show ozzy-probe-host >/dev/null 2>&1; then
        ip link delete ozzy-probe-host
    fi
    if test -e "/run/netns/$namespace"; then ip netns del "$namespace"; fi
    while iptables -t nat -C POSTROUTING -s 10.233.0.2/32 -j MASQUERADE 2>/dev/null; do
        iptables -t nat -D POSTROUTING -s 10.233.0.2/32 -j MASQUERADE
    done
}
case "${1:?}" in
    up)
        cleanup
        trap cleanup ERR
        ip netns add "$namespace"
        ip link add ozzy-probe-host type veth peer name ozzy-probe-peer
        ip link set ozzy-probe-peer netns "$namespace"
        ip addr add 10.233.0.1/24 dev ozzy-probe-host
        ip link set ozzy-probe-host up
        ip -n "$namespace" addr add 10.233.0.2/24 dev ozzy-probe-peer
        ip -n "$namespace" link set ozzy-probe-peer up
        ip -n "$namespace" link set lo up
        ip -n "$namespace" route add default via 10.233.0.1
        sysctl -w net.ipv4.ip_forward=1 >/dev/null
        iptables -t nat -A POSTROUTING -s 10.233.0.2/32 -j MASQUERADE
        ;;
    restrict)
        [[ ${2:?} =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]
        ip netns exec "$namespace" iptables -A OUTPUT -d "$2" -j ACCEPT
        ip netns exec "$namespace" iptables -A OUTPUT -o lo -j ACCEPT
        ip netns exec "$namespace" iptables -P OUTPUT DROP
        ;;
    down)
        cleanup
        ;;
esac

from collections.abc import Coroutine, Sequence
from typing import Any, Self, final

__version__: str
__all__ = [
    "BusyError",
    "Checkpoint",
    "Client",
    "ClosedError",
    "Config",
    "Consumer",
    "OzzyError",
    "PendingRecord",
    "Producer",
    "Receipt",
    "Record",
    "__version__",
]

class OzzyError(Exception): ...
class ClosedError(OzzyError): ...
class BusyError(OzzyError): ...

@final
class Config:
    def __new__(
        cls,
        brokers: Sequence[tuple[bytes, str, str]],
        bounds: tuple[int, int, int, int, int, int],
        capacity: tuple[int, int, int, int],
        timeout: float,
        compression: str,
    ) -> Self: ...

@final
class Client:
    def __new__(cls, config: Config) -> Self: ...
    def connect(self) -> None: ...
    def aconnect(self) -> Coroutine[Any, Any, None]: ...
    def producer(
        self, topic: str, identity: bytes | None = None, takeover: bool = False
    ) -> Producer: ...
    def aproducer(
        self, topic: str, identity: bytes | None = None, takeover: bool = False
    ) -> Coroutine[Any, Any, Producer]: ...
    def consumer(
        self, topic: str, options: tuple[str, Checkpoint | None, Sequence[int] | None]
    ) -> Consumer: ...
    def aconsumer(
        self, topic: str, options: tuple[str, Checkpoint | None, Sequence[int] | None]
    ) -> Coroutine[Any, Any, Consumer]: ...
    def close(self) -> None: ...
    def aclose(self) -> Coroutine[Any, Any, None]: ...

@final
class Producer:
    @property
    def identity(self) -> bytes: ...
    @property
    def partition_count(self) -> int: ...
    def send(
        self,
        parts: bytes | Sequence[bytes],
        id: bytes | None,
        destination: tuple[bytes | None, int | None],
    ) -> PendingRecord: ...
    def asend(
        self,
        parts: bytes | Sequence[bytes],
        id: bytes | None,
        destination: tuple[bytes | None, int | None],
    ) -> Coroutine[Any, Any, PendingRecord]: ...
    def try_send(
        self,
        parts: bytes | Sequence[bytes],
        id: bytes | None,
        destination: tuple[bytes | None, int | None],
    ) -> PendingRecord | None: ...
    def flush(self) -> None: ...
    def aflush(self) -> Coroutine[Any, Any, None]: ...
    def close(self) -> None: ...
    def aclose(self) -> Coroutine[Any, Any, None]: ...

@final
class PendingRecord:
    @property
    def topic_id(self) -> str: ...
    @property
    def partition(self) -> int: ...
    @property
    def sequence(self) -> int: ...
    def confirmed(self) -> Receipt: ...
    def aconfirmed(self) -> Coroutine[Any, Any, Receipt]: ...
    def try_confirmed(self) -> Receipt | None: ...

@final
class Consumer:
    def next(self) -> Record: ...
    def anext(self) -> Coroutine[Any, Any, Record]: ...
    def try_next(self) -> Record | None: ...
    def checkpoint(self) -> Checkpoint: ...
    def stats(self) -> tuple[int, int, int]: ...
    def close(self) -> None: ...
    def aclose(self) -> Coroutine[Any, Any, None]: ...

@final
class Checkpoint:
    def __new__(cls, topic_id: bytes, positions: Sequence[tuple[int, int]]) -> Self: ...
    @property
    def topic_id(self) -> str: ...
    @property
    def positions(self) -> list[tuple[int, int]]: ...

@final
class Record:
    @property
    def topic_id(self) -> str: ...
    @property
    def partition(self) -> int: ...
    @property
    def incarnation(self) -> str: ...
    @property
    def offset(self) -> int: ...
    @property
    def message_id(self) -> str: ...
    @property
    def parts(self) -> tuple[bytes, ...]: ...

@final
class Receipt:
    @property
    def topic_id(self) -> str: ...
    @property
    def partition(self) -> int: ...
    @property
    def incarnation(self) -> str: ...
    @property
    def offset(self) -> int: ...
    @property
    def message_id(self) -> str: ...
    @property
    def producer_id(self) -> str: ...
    @property
    def producer_epoch(self) -> int: ...
    @property
    def owner_epoch(self) -> int: ...
    @property
    def sequence(self) -> int: ...
    @property
    def disposition(self) -> str: ...
    @property
    def policy(self) -> str: ...
